public class StaticObject extends Object {
  StaticObject(float x, float y, float z, float w, float h, float d, float rotX, float rotY, float rotZ) {
    this.x = x;
    this.y = y;
    this.z = z;
    this.w = w;
    this.h = h;
    this.d = d;
    this.rotY = rotY;
    this.rotX = rotX;
    this.rotZ = rotZ;
  }
}
